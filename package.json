{
  "name": "lumina-lista-1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "media:hero:render": "node scripts/render-hero.mjs",
    "media:hero": "node scripts/build-hero-frames.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" vite.config.ts package.json README.md AGENTS.md CHANGELOG.md \"docs/**/*.md\" \".agents/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" vite.config.ts package.json README.md AGENTS.md CHANGELOG.md \"docs/**/*.md\" \".agents/**/*.md\"",
    "predev": "node scripts/static-page.mjs",
    "prebuild": "node scripts/static-page.mjs",
    "media:stickers": "node scripts/build-sticker-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router-dom": "^7.18.4"
  }
}
