{
  "name": "lumina-lista-1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" vite.config.ts components.json package.json README.md AGENTS.md CHANGELOG.md \"docs/**/*.md\" \".agents/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" vite.config.ts components.json package.json README.md AGENTS.md CHANGELOG.md \"docs/**/*.md\" \".agents/**/*.md\"",
    "predev": "node scripts/static-page.mjs",
    "prebuild": "node scripts/static-page.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1"
  }
}
